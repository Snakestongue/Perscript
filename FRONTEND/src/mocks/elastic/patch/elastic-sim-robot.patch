+  <!-- Loading bar shown until Flutter paints its first frame (added for the web training build) -->
+  <style>
+    html, body { background: #0f1115; margin: 0; }
+    #elastic-loading { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center;
+      justify-content: center; gap: 14px; font-family: Roboto, Arial, sans-serif; color: #c9ccd3; z-index: 10;
+      background: #0f1115; transition: opacity .3s; }
+    #elastic-loading .track { width: min(320px, 70vw); height: 6px; border-radius: 3px; background: #2a2e37; overflow: hidden; }
+    #elastic-loading .bar { width: 0%; height: 100%; background: #4f8cff; transition: width .4s ease-out; }
+    #elastic-loading small { color: #8a8f9a; }
+  </style>
+  <div id="elastic-loading" role="progressbar" aria-label="Loading Elastic" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
+    <div>Loading Elastic…</div>
+    <div class="track"><div class="bar" id="elastic-loading-bar"></div></div>
+    <small id="elastic-loading-note">Downloading the dashboard (about 10 MB the first time)</small>
+  </div>
+  <script>
+    (function () {
+      var box = document.getElementById('elastic-loading');
+      var bar = document.getElementById('elastic-loading-bar');
+      var note = document.getElementById('elastic-loading-note');
+      var start = Date.now();
+      // The browser does not report download progress for the app, so ease toward 90%
+      // and jump to 100% when Flutter paints its first frame.
+      var timer = setInterval(function () {
+        var t = (Date.now() - start) / 1000;
+        var pct = Math.round(90 * (1 - Math.exp(-t / 7)));
+        bar.style.width = pct + '%';
+        box.setAttribute('aria-valuenow', pct);
+        if (t > 25) note.textContent = 'Still loading… the first load can take a little while';
+      }, 250);
+      window.addEventListener('flutter-first-frame', function () {
+        clearInterval(timer);
+        bar.style.width = '100%';
+        box.setAttribute('aria-valuenow', 100);
+        box.style.opacity = '0';
+        setTimeout(function () { box.remove(); }, 350);
+        try { window.parent.postMessage({ type: 'elastic-ready' }, '*'); } catch (e) { /* not framed */ }
+      });
+    })();
+  </script>
